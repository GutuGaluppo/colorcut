{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColorCut",
  "version": "0.1.0",
  "identifier": "com.gutugaluppo.colorcut",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ColorCut",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Local palette and cutout utility",
    "longDescription": "ColorCut removes image backgrounds and extracts reusable color palettes locally.",
    "resources": ["resources/models/isnet-general-use.onnx"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
